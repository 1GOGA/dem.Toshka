{
	Tools = ordered() {
		SpeedRamp_Accent = GroupOperator {
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "MediaIn", Source = "Output", },
			},
			Outputs = ordered() {
				Output1 = InstanceOutput { SourceOp = "DirBlur", Source = "Output", },
			},
			Tools = ordered() {
				MediaIn = PipeRouter { ViewInfo = PipeRouterInfo { Pos = { -150, 0 } }, },
				TimeScale = TimeSpeed {
