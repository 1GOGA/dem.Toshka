						Input = Input { SourceOp = "MediaIn", Source = "Output", },
						Speed = Input { Value = 3.5, },
						InterpolateBetweenFrames = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -20, 0 } },
				},
				DirBlur = DirectionalBlur {
